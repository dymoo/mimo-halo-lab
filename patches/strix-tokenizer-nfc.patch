+void unicode_normalize_nfc(std::string & text) {
+    // NFC is a no-op for ASCII, and avoiding ICU setup here keeps the legacy
+    // fast path allocation-free when the opt-in metadata is present.
+    if (text.empty() || std::all_of(text.begin(), text.end(), [] (const char byte) {
+            return static_cast<unsigned char>(byte) < 0x80;
+        })) {
+        return;
+    }
+
+    const int32_t utf8_length = unicode_icu_length(text.size());
+    UErrorCode error = U_ZERO_ERROR;
+    const UNormalizer2 * const nfc = unorm2_getNFCInstance(&error);
+    if (U_FAILURE(error) || nfc == nullptr) {
+        unicode_nfc_throw(error);
+    }
+
+    int32_t utf16_length = 0;
+    error = U_ZERO_ERROR;
+    u_strFromUTF8WithSub(
+        nullptr, 0, &utf16_length, text.data(), utf8_length, 0xFFFD, nullptr, &error);
+    if (error != U_BUFFER_OVERFLOW_ERROR && U_FAILURE(error)) {
+        unicode_nfc_throw(error);
+    }
+
+    // Match the tokenizer's established malformed-UTF-8 behavior: replace
+    // each invalid input sequence with U+FFFD instead of throwing across the
+    // public tokenization API.
+    std::vector<UChar> utf16(static_cast<size_t>(utf16_length));
+    int32_t utf16_written = 0;
+    error = U_ZERO_ERROR;
+    u_strFromUTF8WithSub(
+        utf16.data(), utf16_length, &utf16_written, text.data(), utf8_length,
+        0xFFFD, nullptr, &error);
+    if (U_FAILURE(error)) {
+        unicode_nfc_throw(error);
+    }
+
+    int32_t normalized_length = 0;
+    error = U_ZERO_ERROR;
+    normalized_length = unorm2_normalize(nfc, utf16.data(), utf16_written, nullptr, 0, &error);
+    if (error != U_BUFFER_OVERFLOW_ERROR && U_FAILURE(error)) {
+        unicode_nfc_throw(error);
+    }
+
+    std::vector<UChar> normalized(static_cast<size_t>(normalized_length));
+    int32_t normalized_written = 0;
+    error = U_ZERO_ERROR;
+    normalized_written = unorm2_normalize(
+        nfc, utf16.data(), utf16_written, normalized.data(), normalized_length, &error);
+    if (U_FAILURE(error)) {
+        unicode_nfc_throw(error);
+    }
+
+    int32_t utf8_normalized_length = 0;
+    error = U_ZERO_ERROR;
+    u_strToUTF8(
+        nullptr, 0, &utf8_normalized_length, normalized.data(), normalized_written, &error);
+    if (error != U_BUFFER_OVERFLOW_ERROR && U_FAILURE(error)) {
+        unicode_nfc_throw(error);
+    }
+
+    std::string normalized_text(static_cast<size_t>(utf8_normalized_length), '\0');
+    int32_t utf8_written = 0;
+    error = U_ZERO_ERROR;
+    u_strToUTF8(
+        normalized_text.data(), utf8_normalized_length, &utf8_written,
+        normalized.data(), normalized_written, &error);
+    if (U_FAILURE(error)) {
+        unicode_nfc_throw(error);
+    }
+    normalized_text.resize(static_cast<size_t>(utf8_written));
+    text = std::move(normalized_text);
+}
