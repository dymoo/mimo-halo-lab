         self.block_count = self.hparams["num_hidden_layers"] + self._n_nextn
         self.tensor_map = gguf.get_tensor_name_map(self.model_arch, self.block_count)
 
+        self._experts = None
+        self._expert_formats = None
+        self._mxfp4_experts_written = False
+
+        # Native checkpoints store routed experts as compressed-tensors
+        # "mxfp4-pack-quantized" (quantization_config.store_dtype == "mxfp4").
+        # Second-generation candidate builds record "second_gen_affine" instead:
+        # its group-affine expert codes have no GGML decoder, so refuse them
+        # explicitly rather than mislabel them native MXFP4 or requantize
+        # source values.
+        quant_config = self.hparams.get("quantization_config")
+        store_dtype = quant_config.get("store_dtype") if isinstance(quant_config, dict) else None
+        if store_dtype is not None and store_dtype != "mxfp4":
+            raise ValueError(
+                f"unsupported expert format: quantization_config.store_dtype={store_dtype!r} "
+                "(expected 'mxfp4'): second_gen_affine/unknown expert codes have no GGML "
+                "decoder - refusing to mislabel them native MXFP4 or requantize source "
+                "values; use the exact layer-streamed evaluation path until a dedicated "
+                "decoder/kernel exists")
