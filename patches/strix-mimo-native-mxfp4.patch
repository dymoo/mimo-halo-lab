+    def _classify_expert_pair(self, bid: int, proj: str, xid: int) -> str | None:
+        """Pair an expert payload with its scale sibling and classify the layout.
+
+        Returns "mxfp4" (packed uint8 payload + E8M0 scale sibling), "dense"
+        (float payload, no sibling) or None while the pair is incomplete.
+        Unknown layouts - notably second_gen_affine group-affine codes - are
+        refused explicitly: ggml has no decoder for them, and mislabeling them
+        native MXFP4 or requantizing source values are both forbidden.
+        """
+        w_name = f"model.layers.{bid}.mlp.experts.{xid}.{proj}.weight"
+        s_name = w_name + "_scale"
+        bucket = self._experts[bid]
+        if w_name not in bucket:
+            return None
+        weight = bucket[w_name]
+        e8m0 = getattr(torch, "float8_e8m0fnu", None)
+
+        if s_name not in bucket:
+            if weight.dtype == torch.uint8:
+                return None  # packed payload: wait for its scale sibling
+            if weight.dtype in (torch.float16, torch.bfloat16, torch.float32):
+                return "dense"
+            raise ValueError(self._unsupported_expert_format(
+                w_name, f"expert payload dtype {weight.dtype}"))
+
+        scale = bucket[s_name]
+        if weight.dtype == torch.uint8 and scale.ndim == 2 and (
+                scale.dtype == torch.uint8 or scale.dtype == e8m0):
+            return "mxfp4"
+        if weight.dtype == torch.uint8 and scale.ndim == 3:
+            raise ValueError(self._unsupported_expert_format(
+                s_name, "second_gen_affine group-affine scale/zero pairs"))
+        raise ValueError(self._unsupported_expert_format(
+            s_name, f"expert scale layout dtype={scale.dtype} shape={tuple(scale.shape)}"))
 
-                    data_torch = torch.stack(datas, dim=0)
-                    merged_name = f"model.layers.{bid}.mlp.experts.{w_name}.weight"
+    @staticmethod
+    def _unsupported_expert_format(name: str, what: str) -> str:
+        return (
+            f"unsupported expert format: {name}: {what} - second_gen_affine/unknown "
+            "expert codes have no GGML decoder; refusing to mislabel them native MXFP4 "
+            "or requantize source values; use the exact layer-streamed evaluation path "
+            "until a dedicated decoder/kernel exists")
+
+    def _merge_experts(self, bid: int, n_experts: int):
+        # merge each projection of one layer into a single 3d tensor (dense) or
+        # one raw ggml MXFP4 tensor (packed native mxfp4, lossless repack)
+        formats = self._expert_formats[bid]
+        for w_name in ["gate_proj", "up_proj", "down_proj"]:
+            fmts = {formats[(xid, w_name)] for xid in range(n_experts)}
+            if len(fmts) != 1:
+                raise ValueError(self._unsupported_expert_format(
+                    f"model.layers.{bid}.mlp.experts.{w_name}.weight",
+                    f"mixed pair formats {sorted(fmts)} within one projection"))
+
+            names = [f"model.layers.{bid}.mlp.experts.{xid}.{w_name}.weight"
+                     for xid in range(n_experts)]
+            if fmts == {"mxfp4"}:
+                self._write_mxfp4_expert_tensor(bid, w_name, names)
+                continue
 
-                    yield from super().modify_tensors(data_torch, merged_name, bid)
-                return
-            else:
-                return
-        yield from super().modify_tensors(data_torch, name, bid)
+            datas: list[Tensor] = []
+            for xid in range(n_experts):
+                ename_to_retrieve = f"model.layers.{bid}.mlp.experts.{xid}.{w_name}.weight"
+                datas.append(self._experts[bid].pop(ename_to_retrieve))
+
+            data_torch = torch.stack(datas, dim=0)
+            if data_torch.dtype not in (torch.float16, torch.float32):
+                data_torch = data_torch.to(torch.float32)
+            merged_name = f"model.layers.{bid}.mlp.experts.{w_name}.weight"
+
+            yield from super().modify_tensors(data_torch, merged_name, bid)
+        self._expert_formats[bid].clear()
+
+    def _write_mxfp4_expert_tensor(self, bid: int, proj: str, names: list[str]) -> None:
+        # lossless repack of compressed-tensors "mxfp4-pack-quantized" expert
+        # weights into ggml block_mxfp4 (same machinery as DeepseekV4Model)
+        data: np.ndarray | None = None
+        for xid in range(len(names)):
+            w_name = names[xid]
+            s_name = w_name + "_scale"
+            weight = LazyTorchTensor.to_eager(self._experts[bid].pop(w_name))
+            scale = LazyTorchTensor.to_eager(self._experts[bid].pop(s_name))
+            packed = self.repack_mxfp4_blocks(weight, scale)
+            if data is None:
+                data = np.empty((len(names), *packed.shape), dtype=packed.dtype)
+            data[xid] = packed
+
+        assert data is not None
+        new_name = self.map_tensor_name(f"model.layers.{bid}.mlp.experts.{proj}.weight")
+        shape = gguf.quant_shape_from_byte_shape(data.shape, gguf.GGMLQuantizationType.MXFP4)
+        logger.info(f"{new_name}: repacked routed experts to MXFP4, shape = {{{', '.join(str(n) for n in reversed(shape))}}}")
+        self.gguf_writer.add_tensor(new_name, data, raw_dtype=gguf.GGMLQuantizationType.MXFP4)
+        self._mxfp4_experts_written = True
 
