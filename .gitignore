# Local-only large payloads: models, datasets, traces, calibration, workspaces.
# Private payloads stay on the workstation; Git carries only manifests and hashes.
/models/
/datasets/private/
/traces/raw/
/traces/normalized-private/
/calibration/cache/
/artifacts/models/
/scratch/
/.scratch/
/.cache/
/upstreams/

# Secrets and environment configuration
.env
.env.*
*.env
.envrc
!.env.example

# Model and binary artifacts
*.gguf
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.onnx
*.ggml

# NumPy artifacts
*.npy
*.npz
*.parquet.private

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# OS noise
.DS_Store

# Halogen archaeology: regenerable fixture objects + large local analysis dumps.
# Fixture generators and ground_truth.json are tracked; binaries regenerate via
# research/halogen/tools/tests/make_fixtures.py. Compact summaries are tracked;
# raw extraction dumps stay on the workstation.
research/halogen/tools/tests/fixtures/*.o
/research/halogen/results/
